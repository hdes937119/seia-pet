# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server bind address. Defaults to 127.0.0.1 (this computer only).
# Set to 0.0.0.0 only if you really want other devices on your network to reach it.
# HOST="127.0.0.1"
# PORT=3000

# GPT-SoVITS local voice settings (all optional; defaults shown)
# SOVITS_URL="http://127.0.0.1:9880"
# SOVITS_GPT_WEIGHTS="GPT_weights/MuYue-e15.ckpt"
# SOVITS_SOVITS_WEIGHTS="SoVITS_weights/MuYue_e24_s408.pth"
# SOVITS_REF_AUDIO="C:/Users/user/Desktop/TTS/Mutsuki.wav"
# SOVITS_PROMPT_TEXT="先生、先生！今日は何して遊ぶ？じゃんけん？缶蹴り？"
# SOVITS_PROMPT_LANG="ja"
