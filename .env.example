# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server bind address. Defaults to 127.0.0.1 (this computer only).
# Set to 0.0.0.0 only if you really want other devices on your network to reach it.
# HOST="127.0.0.1"
# PORT=3000

# GPT-SoVITS local voice settings (all optional; defaults shown)
# SOVITS_URL="http://127.0.0.1:9880"
# SOVITS_GPT_WEIGHTS="GPT_weights/MuYue-e15.ckpt"
# SOVITS_SOVITS_WEIGHTS="SoVITS_weights/MuYue_e24_s408.pth"
# SOVITS_REF_AUDIO="C:/Users/user/Desktop/TTS/Mutsuki.wav"
# SOVITS_PROMPT_TEXT="先生、先生！今日は何して遊ぶ？じゃんけん？缶蹴り？"
# SOVITS_PROMPT_LANG="ja"

# Reddit: your own front page (private RSS, no Reddit API needed).
# Open https://old.reddit.com/prefs/feeds/ while logged in, right-click the RSS button
# on the "your front page" row, copy the link and paste it here. Keep it private.
# REDDIT_FRONTPAGE_RSS=https://www.reddit.com/.rss?feed=YOUR_TOKEN&user=YOUR_NAME

# ── LINE (chat with her as a LINE friend, private chat only) ──
# From LINE Developers console → your Messaging API channel:
#   "Basic settings" → Channel secret, "Messaging API" → Channel access token (long-lived)
# LINE_CHANNEL_SECRET=
# LINE_CHANNEL_ACCESS_TOKEN=
# Local port that LINE's webhook reaches through your tunnel (only LINE traffic goes here).
# LINE_WEBHOOK_PORT=3001
# Limits for messages she sends first (replies are free and unlimited). Free plan = 200/month.
# LINE_PUSH_DAILY_LIMIT=5
# LINE_PUSH_MONTHLY_LIMIT=180

# ── Google Calendar reminders (sent on LINE the evening before) ──
# Google Calendar (web) → Settings → your calendar → "Integrate calendar"
# → "Secret address in iCal format". Several calendars: separate with commas. Keep it private.
# GOOGLE_CALENDAR_ICS=https://calendar.google.com/calendar/ical/.../private-.../basic.ics
# Time of day (24h) after which she reminds you about tomorrow's events.
# CALENDAR_REMIND_AT=20:00

# 天氣（她討厭下雨：外面真的在下雨時心情會變差）。預設台北，其他地方填經緯度
# WEATHER_LAT=25.03
# WEATHER_LON=121.56
